{
  "format": 1,
  "id": "me-command-centre",
  "version": "1.0.0",
  "name": {
    "en": "ME/RS command centre",
    "de": "ME/RS-Leitstand"
  },
  "description": {
    "en": "Your storage network as a command centre: capacity, item search, watchlist and crafting jobs on two pages.",
    "de": "Dein Speichernetz als Leitstand: Kapazität, Itemsuche, Watchlist und Crafting-Aufträge auf zwei Seiten."
