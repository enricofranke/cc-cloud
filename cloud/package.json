{
  "name": "cccloud-web",
  "version": "0.1.0",
  "private": true,
  "description": "CC: Cloud web dashboard (bundled into the mod jar) + dev mock server",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node dev/build-models.ts && node dev/build-recipes.ts && vite build",
    "preview": "pnpm build && node dev/run.ts",
    "mock": "node dev/run.ts",
    "test": "vitest run --maxWorkers=3",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "screenshots": "node dev/screenshots.ts",
    "models": "node dev/build-models.ts",
    "screenshots:editor": "node dev/editor-shots.ts",
    "recipes": "node dev/build-recipes.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1",
    "preact": "^10.29.8",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
